@misc{kong_illustration_2019,
	title = {An illustration of reproducibility in neuroscience research in the absence of selective reporting},
	url = {http://biorxiv.org/lookup/doi/10.1101/866301},
	doi = {10.1101/866301},
	abstract = {Abstract

            The problem of poor reproducibility of scientific findings has received much attention over recent years, in a variety of fields including psychology and neuroscience. The problem has been partly attributed to publication bias and unwanted practices such as
            p
            -hacking. Low statistical power in individual studies is also understood to be an important factor. In a recent multi-site collaborative study, we mapped brain anatomical left-right asymmetries for regional measures of surface area and cortical thickness, in 99 MRI datasets from around the world, for a total of over 17,000 participants. In the present study, we re-visited these hemispheric effects from the perspective of reproducibility. Within each dataset, we considered that an effect had been reproduced when it matched the meta-analytic effect from the 98 other datasets, in terms of effect direction and uncorrected significance at
            p
            {\textless}0.05. In this sense, the results within each dataset were viewed as coming from separate studies in an ‘ideal publishing environment’, i.e. free from selective reporting and
            p
            hacking. We found an average reproducibility rate per dataset, over all effects, of 63.2\% (
            SD
            = 22.9\%, min = 22.2\%, max = 97.0\%). As expected, reproducibility was higher for larger effects and in larger datasets. There is clearly substantial room to improve reproducibility in brain MRI research through increasing statistical power. These findings constitute an empirical illustration of reproducibility in the absence of publication bias or
            p
            hacking, when assessing realistic biological effects in heterogeneous neuroscience data, and given typically-used sample sizes.},
	language = {en},
	urldate = {2025-11-17},
	publisher = {Neuroscience},
	author = {Kong, Xiang-Zhen and {ENIGMA Laterality Working Group} and Francks, Clyde},
	month = dec,
	year = {2019},
}

@article{masson-trottier_toward_2025,
	title = {Toward the future of scientific publishing through reproducible research artefacts enabled by {Neurodesk}},
	volume = {5},
	copyright = {http://creativecommons.org/licenses/by/4.0},
	issn = {2957-3963},
	url = {https://apertureneuro.org/article/143700-toward-the-future-of-scientific-publishing-through-reproducible-research-artefacts-enabled-by-neurodesk},
	doi = {10.52294/001c.143700},
	abstract = {Computational tools are essential to neuroimaging research, yet their development, use, and citation are inconsistently addressed in current scientific publishing frameworks. Despite increasing adoption of the FAIR and FAIR4RS principles, challenges remain in ensuring the reproducibility, accessibility, and attribution of research software. This article presents how Neurodesk, an open-source, community-driven platform improves the transparency, portability, and sustainability of neuroimaging workflows. Neurodesk uses containerisation to encapsulate complete software environments that are portable across operating systems and computing infrastructures. Each container and workflow can be versioned and assigned a persistent DOI to support formal citation and long-term access. Through concrete use cases, we illustrate how Neurodesk facilitates code review, supports methodological extension, and fosters sustainable tool development. We argue that platforms like Neurodesk provide a practical infrastructure for enacting cultural and technical shifts in publishing, making research software a primary research output. By integrating attribution, standardisation, and reproducibility into everyday research workflows, Neurodesk exemplifies how future scientific publishing can more effectively recognise and preserve computational contributions.},
	language = {en},
	number = {SI 3},
	urldate = {2025-11-17},
	journal = {Aperture Neuro},
	author = {Masson-Trottier, Michèle and Dao, Thuy T. and Narayanan, Aswin and Bollmann, Steffen},
	month = sep,
	year = {2025},
}

