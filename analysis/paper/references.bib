@article{abdill_how-guide_2024,
	title = {A how-to guide for code sharing in biology},
	volume = {22},
	issn = {1545-7885},
	url = {https://dx.plos.org/10.1371/journal.pbio.3002815},
	doi = {10.1371/journal.pbio.3002815},
	abstract = {In 2024, all biology is computational biology. Computer-aided analysis continues to spread into new fields, becoming more accessible to researchers trained in the wet lab who are eager to take advantage of growing datasets, falling costs, and novel assays that present new opportunities for discovery. It is currently much easier to find guidance for implementing these techniques than for reporting their use, leaving biologists to guess which details and files are relevant. In this essay, we review existing literature on the topic, summarize common tips, and link to additional resources for training. Following this overview, we then provide a set of recommendations for sharing code, with an eye toward guiding those who are comparatively new to applying open science principles to their computational work. Taken together, we provide a guide for biologists who seek to follow code sharing best practices but are unsure where to start.},
	language = {en},
	number = {9},
	urldate = {2025-11-17},
	journal = {PLOS Biology},
	author = {Abdill, Richard J. and Talarico, Emma and Grieneisen, Laura},
	month = sep,
