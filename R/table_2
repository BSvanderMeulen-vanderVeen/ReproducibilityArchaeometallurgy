# Import data and remove comments
scores <- readr::read_csv(./reprod_astr_anonymised.csv)

scores <- subset(c("Stage_0", 
                   "Stage_1",
                   "Stage_2",
                   "Stage_3",
                   "Stage_4",
                   "Stage_5",
                   "Stage_6",
                   "Stage_7",
                   "Stage_8",
                   "Stage_9",
                   "Stage_10",
                   "Stage_11",
                   "Stage_12",
                   )
                 )

# Add column with total score sum per row
scores$Total <- rowSums(scores)

# Produce summary statistics and save in data frame (soon to be deprecated)
summary <- broom::tidy(scores)

# Select columns for publication
overview <- subset(summary, 
                   select = c(column, 
                              mean, 
                              median, 
                              min, 
                              max
                              )
                   )

#Rename columns for publication
names(overview) <- c("Stage", 
                     "Mean", 
                     "Median", 
                     "Minimum", 
                     "Maximum"
                     )

# Save data frame as .csv
utils::write.csv2(overview, "table_2.csv", na = "", row.names = FALSE)
